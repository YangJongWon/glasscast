// Copy to Secrets.xcconfig (git-ignored) and fill in.

// Your Apple Developer Team ID (Xcode > Signing & Capabilities).
DEVELOPMENT_TEAM = ABCDE12345

// A bundle ID you own. Must match the iOS app registered in the Wearables Developer Center.
PRODUCT_BUNDLE_IDENTIFIER = com.example.glasscast

// From https://wearables.developer.meta.com > Manage projects. Leave empty when using
// Developer Mode in the Meta AI app. Note: "//" starts a comment in xcconfig, so tokens
// containing "//" need $() between the slashes.
META_APP_ID =
CLIENT_TOKEN =
